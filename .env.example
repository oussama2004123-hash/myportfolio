# Email Configuration
# Choose one: 'gmail' or 'smtp'
EMAIL_SERVICE=gmail

# For Gmail: Use your email and App Password (not regular password)
# Generate App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# For SMTP: Configure your SMTP server details
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false

# Email where contact form submissions will be sent
CONTACT_EMAIL=oussamahitte6@gmail.com

# Server Port (optional, defaults to 3000)
PORT=3000
